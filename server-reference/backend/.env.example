# PHP-FPM / Docker server environment. Do not commit real values.
NETFORGE_DB_DIR=/var/lib/netforge
NETFORGE_ORIGIN=https://igoon.github.io
NETFORGE_GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
NETFORGE_ALLOW_HTTP=0
# TLS gateway MUST set trusted X-Forwarded-Proto=https; never accept untrusted forwarded headers.
